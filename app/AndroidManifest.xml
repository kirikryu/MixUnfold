<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cetushome.rotationunlock"
    android:versionCode="21"
    android:versionName="1.8.0">

    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="30" />

    <!-- Android 11+ 包可见性：排除清单的应用选择器需要完整已安装应用列表 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 设置页直写 Settings.System（app-op 授权一次，替代逐条 su 写入） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="MixUnfold"
        android:allowBackup="false">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="MIX FOLD 1 (cetus): rotation unlock (launcher + unfolded lockscreen + inner-screen free rotation), per-orientation grid tuning, with control panel" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:value="com.miui.home;com.android.systemui;android" />

        <activity
            android:name="cetushome.hook.MainActivity"
            android:exported="true"
            android:label="MixUnfold">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="cetushome.hook.AppPickerActivity"
            android:exported="false"
            android:label="排除应用" />
    </application>
</manifest>
