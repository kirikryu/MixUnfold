<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cetushome.rotationunlock"
    android:versionCode="27"
    android:versionName="1.9.1">

    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="30" />

    <!-- Android 11+ 包可见性：排除清单的应用选择器需要完整已安装应用列表 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 1.9.0 起配置存于模块私有 SharedPreferences，不再申请 WRITE_SETTINGS -->

    <application
        android:label="MixUnfold"
        android:allowBackup="false">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="MIX FOLD 1 (cetus): rotation unlock (launcher + unfolded lockscreen + inner-screen free rotation), per-orientation grid tuning, with control panel" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:value="com.miui.home;com.android.systemui;android" />
        <!-- LSPosed 新 XSharedPreferences：hook 进程经 lspd 读取模块私有 prefs
             （classic 直读 app 数据目录被 SELinux 拦截，真机 LSPosed 2.2.1 实测）；
             watcher 允许 hook 侧注册变更监听（不可用时 500ms 轮询兜底） -->
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data android:name="xposedsharedprefswatcher" android:value="true" />

        <activity
            android:name="cetushome.hook.MainActivity"
            android:exported="true"
            android:label="MixUnfold">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="cetushome.hook.AppPickerActivity"
            android:exported="false"
            android:label="排除应用" />
    </application>
</manifest>
